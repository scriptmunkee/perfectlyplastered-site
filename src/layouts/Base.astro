---
// Minimal shell. The real head, nav, footer, sticky call bar, schema and
// consent banner get built after the brief and design direction are signed off.
import { site } from '../data/site';
interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <slot />
  </body>
</html>
